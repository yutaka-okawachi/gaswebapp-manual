diff --git a/app/dashboard-proxy.ts b/app/dashboard-proxy.ts
new file mode 100644
--- /dev/null
+++ b/app/dashboard-proxy.ts
@@ -0,0 +1,37 @@
+// Server-only: imported by the Worker, never by a client component.
+import { GAS_API_URL } from "./config";
+import { parseDashboardData, type Period } from "./dashboard-data";
+
+type ProxyEnv = { DASHBOARD_API_TOKEN?: string };
+const responseHeaders = { "Cache-Control": "no-store, private", "Content-Type": "application/json; charset=utf-8", "X-Content-Type-Options": "nosniff" };
+
+export async function dashboardProxy(request: Request, env: ProxyEnv, upstream: typeof fetch = fetch): Promise<Response> {
+  const reply = (status: number, code: string) => new Response(JSON.stringify({ error: { code } }), { status, headers: responseHeaders });
+  // Dispatch enforces the existing owner-only Site policy on every path, including
+  // this endpoint. Require its authenticated visitor identity as defense in depth.
+  if (!request.headers.get("oai-authenticated-user-email")) return reply(401, "UNAUTHORIZED");
+  if (request.method !== "GET") return reply(405, "METHOD_NOT_ALLOWED");
+  const url = new URL(request.url);
+  const period = url.searchParams.get("period"), language = url.searchParams.get("language") || "all";
+  if (!["7", "30", "90", "180"].includes(period || "") || !["all", "ja", "en"].includes(language) ||
+      [...url.searchParams.keys()].some(key => !["period", "language"].includes(key)) ||
+      url.searchParams.getAll("period").length !== 1 || url.searchParams.getAll("language").length > 1) return reply(400, "INVALID_SELECTION");
+  if (typeof env.DASHBOARD_API_TOKEN !== "string" || env.DASHBOARD_API_TOKEN.length < 32) return reply(503, "CONFIGURATION_ERROR");
+  try {
+    const result = await upstream(GAS_API_URL, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ api: "dashboard", period, language, dashboardToken: env.DASHBOARD_API_TOKEN }),
+      cache: "no-store",
+      signal: AbortSignal.timeout(55000),
+    });
+    if (!result.ok) return reply(502, "UPSTREAM_ERROR");
+    // GAS ContentService returns HTTP 200 even for an authentication error.
+    const data = parseDashboardData(await result.json(), Number(period) as Period);
+    if ((data.selectedLanguage ?? "all") !== language || (language !== "all" && data.schemaVersion !== 9)) return reply(502, "UPSTREAM_ERROR");
+    return new Response(JSON.stringify(data), { status: 200, headers: responseHeaders });
+  } catch {
+    // Do not forward upstream bodies, tokens, request URLs or exception details.
+    return reply(502, "UPSTREAM_ERROR");
+  }
+}
diff --git a/tests/dashboard-proxy.test.mjs b/tests/dashboard-proxy.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/dashboard-proxy.test.mjs
@@ -0,0 +1,65 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import vm from "node:vm";
+import { createRequire } from "node:module";
+import test from "node:test";
+const require = createRequire(import.meta.url), ts = require("typescript");
+const secret = "synthetic-read-only-dashboard-token";
+const fixture = JSON.parse(fs.readFileSync(new URL("fixtures/schema9.json", import.meta.url), "utf8"));
+function load(relative) {
+  const file = new URL(relative, import.meta.url);
+  const code = ts.transpileModule(fs.readFileSync(file, "utf8"), { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS } }).outputText;
+  const module = { exports: {} };
+  vm.runInNewContext(code, { module, exports: module.exports, URL, Request, Response, AbortSignal, fetch,
+    require: name => name === "./config" ? { GAS_API_URL: "https://example.invalid/fixed-gas" } : name === "./dashboard-data" ? load("../app/dashboard-data.ts") : require(name) });
+  return module.exports;
+}
+const { dashboardProxy } = load("../app/dashboard-proxy.ts");
+const request = (query = "period=7&language=en", authenticated = true, method = "GET") => new Request("https://dashboard.example/api/dashboard?" + query, { method, headers: authenticated ? { "oai-authenticated-user-email": "owner@example.invalid" } : {} });
+
+test("anonymous, invalid selections and missing secrets never contact GAS", async () => {
+  let calls = 0;
+  const upstream = async () => { calls++; throw Error("Must not run"); };
+  assert.equal((await dashboardProxy(request(undefined, false), { DASHBOARD_API_TOKEN: secret }, upstream)).status, 401);
+  assert.equal((await dashboardProxy(request(undefined, true, "POST"), { DASHBOARD_API_TOKEN: secret }, upstream)).status, 405);
+  for (const query of ["period=1", "period=7&language=fr", "period=7&period=30", "period=7&dashboardToken=caller", "period=7&url=https://example.invalid"]) {
+    assert.equal((await dashboardProxy(request(query), { DASHBOARD_API_TOKEN: secret }, upstream)).status, 400);
+  }
+  assert.equal((await dashboardProxy(request(), {}, upstream)).status, 503);
+  assert.equal(calls, 0);
+});
+test("authenticated proxy preserves validated data and sends the read-only secret only in the POST body", async () => {
+  for (const language of ["all", "ja", "en"]) {
+    const expected = structuredClone(fixture); expected.selectedLanguage = language;
+    const response = await dashboardProxy(request("period=7&language=" + language), { DASHBOARD_API_TOKEN: secret }, async (url, init) => {
+      assert.equal(url, "https://example.invalid/fixed-gas"); assert.equal(init.method, "POST");
+      assert.deepEqual(JSON.parse(init.body), { api: "dashboard", period: "7", language, dashboardToken: secret });
+      assert.equal(init.cache, "no-store"); return Response.json(expected);
+    });
+    assert.equal(response.status, 200); assert.equal(response.headers.get("cache-control"), "no-store, private");
+    const body = await response.text(); assert(!body.includes(secret)); assert.deepEqual(JSON.parse(body), expected);
+  }
+});
+test("GAS error bodies, mismatched language and exceptions never leak upstream details or credentials", async () => {
+  for (const upstream of [
+    async () => Response.json({ error: { code: "UNAUTHORIZED", message: secret } }),
+    async () => Response.json({ ...fixture, selectedLanguage: "ja" }),
+    async () => Response.json(fixture, { status: 503 }),
+    async () => { throw Error(secret); },
+  ]) {
+    const response = await dashboardProxy(request(), { DASHBOARD_API_TOKEN: secret }, upstream);
+    assert.equal(response.status, 502); assert.deepEqual(await response.json(), { error: { code: "UPSTREAM_ERROR" } });
+  }
+});
+test("built Worker protects the actual /api/dashboard route before the page router", async () => {
+  const { default: worker } = await import("../dist/server/index.js");
+  const response = await worker.fetch(request(undefined, false), { ASSETS: { fetch: async () => new Response("Not found", { status: 404 }) } }, { waitUntil() {}, passThroughOnException() {} });
+  assert.equal(response.status, 401); assert.equal((await response.json()).error.code, "UNAUTHORIZED");
+});
+test("browser bundle contains neither dashboard secret bindings nor direct GAS fetch configuration", () => {
+  for (const name of fs.readdirSync(new URL("../dist/client/assets", import.meta.url)).filter(name => name.endsWith(".js"))) {
+    const source = fs.readFileSync(new URL("../dist/client/assets/" + name, import.meta.url), "utf8");
+    assert(!source.includes("DASHBOARD_API_TOKEN"), name); assert(!source.includes("dashboardToken"), name);
+    assert(!source.includes("script.google.com/macros/s/"), name);
+  }
+});
